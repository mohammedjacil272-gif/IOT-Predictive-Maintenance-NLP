# Local development only. Leave blank unless the corresponding service is running.
IOT_MQTT_HOST=localhost
IOT_MQTT_PORT=1883
IOT_MQTT_TOPIC=industrial/sensors
IOT_MQTT_QOS=0
IOT_INFLUXDB_URL=http://localhost:8086
IOT_INFLUXDB_ORG=IOT
IOT_INFLUXDB_BUCKET=industrial_sensors
IOT_INFLUXDB_TOKEN=
IOT_INFLUXDB_MEASUREMENT=fd001_sensor_reading

# Optional local-only assistant model gateway. No model is downloaded automatically.
IOT_ASSISTANT_MODEL_PROVIDER=ollama
IOT_ASSISTANT_MODEL=
IOT_ASSISTANT_MODEL_BASE_URL=http://127.0.0.1:11434
IOT_ASSISTANT_MODEL_TIMEOUT=20
IOT_ASSISTANT_MODEL_RETRIES=1
IOT_ASSISTANT_MAX_RESPONSE_TOKENS=
IOT_ASSISTANT_TEMPERATURE=0.2

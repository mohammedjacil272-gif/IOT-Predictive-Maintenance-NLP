{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgeAI Industrial Console",
  "version": "0.1.0",
  "identifier": "com.iotintegrated.forgeai",
  "build": {"beforeDevCommand": "npm --prefix ../frontend run dev -- --host 127.0.0.1 --port 1420", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm --prefix ../frontend run build", "frontendDist": "../frontend/dist"},
  "app": {"windows": [{"title": "ForgeAI Industrial Console", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640, "resizable": true}], "security": {"csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"}},
  "bundle": {"active": true, "targets": ["nsis"], "windows": {"nsis": {"installMode": "currentUser"}}, "externalBin": ["binaries/iot-backend"]}
}
